# ShopVoice Pay configuration. Copy to .env and fill in. Never commit .env.
# Sandbox only: there is no live PayPal mode.

# --- PayPal -----------------------------------------------------------------
# mock    : in-process fake PayPal, no network, no credentials (default)
# sandbox : real https://api-m.sandbox.paypal.com with a sandbox REST app
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the developer dashboard (or the spike's S6.1) for signature checks
PAYPAL_WEBHOOK_ID=

# --- Spike / sandbox integration tests (npm run spike, npm run test:sandbox) --
# Sandbox business account that plays the supplier "Northside Dairy"
SPIKE_SUPPLIER_EMAIL=
# Sandbox personal account (the shop owner / payer): approves orders and vaults in the spike
SPIKE_BUYER_EMAIL=
# Sandbox-only password of that account; lets the spike approve in headless Chromium
SPIKE_BUYER_PASSWORD=
# Optional scratch file where the spike leaves the vault id for toolkit/sandbox runs (never commit)
SPIKE_STATE_FILE=
# Public https URL that PayPal can reach, only for registering a webhook in the spike
SPIKE_WEBHOOK_URL=
# Vault id saved by the spike (S3.1); lets test:sandbox run the money flow unattended
SANDBOX_VAULT_ID=
SANDBOX_SUPPLIER_EMAIL=
# Sandbox business accounts for the other demo suppliers, comma-separated, in order:
# Valley Farm Eggs, Hillside Bakery, Harbor Wholesale. Unset ones keep fictional example.com addresses.
SANDBOX_SUPPLIER_EMAILS=

# --- MCP server --------------------------------------------------------------
# memory: seeded demo data, no Postgres. postgres: needs MCP_DB_URL.
MCP_DATA_BACKEND=memory
# >= 32 random characters; bearer token for the seeded demo tenant (memory backend)
MCP_DEMO_TOKEN=
MCP_DB_URL=
# Or in parts (render.yaml): host, port, database, and the RLS-bound login role
MCP_DB_HOST=
MCP_DB_PORT=5432
MCP_DB_NAME=shopvoice
MCP_DB_USER=
MCP_DB_PASSWORD=
# Behind a proxy: which X-Forwarded-For entry, counted from the right, is the client
# (false = ignore the header, true = 1, Render = 2)
MCP_TRUST_PROXY=false
# Deploy only (scripts/deploy/db_prepare.mjs): the Postgres superuser that applies migrations
DB_ADMIN_URL=
MCP_PORT=8090
# Public origin (https://host) enables OAuth sign-up; leave empty locally
PUBLIC_BASE_URL=
OAUTH_COOKIE_SECRET=
# 32-byte base64 key for envelope encryption of vault ids (required with PAYPAL_MODE=sandbox;
# mock mode uses a throwaway key when unset)
APP_MEK_B64=
# Where PayPal returns the owner after approving (the console's public URL)
CONSOLE_PUBLIC_URL=http://localhost:8091
# How long a step-up approval stays open, and the shop timezone used for daily/weekly budgets
PAYMENTS_APPROVAL_TTL_SECONDS=900
SHOP_TIMEZONE=America/New_York
# How long a tool waits for the owner's answer in an MCP client's confirmation form
MCP_ELICITATION_TIMEOUT_MS=120000

# Shared by the MCP server and the console: when set, every console visitor gets a
# private sample shop ("Try the demo"). Generate a long random value; never commit it.
DEMO_PROVISION_SECRET=
# Visitor shops unused for this many days are removed
DEMO_SHOP_IDLE_DAYS=3

# --- Console / AI brain ------------------------------------------------------
# Session cookie is Secure (set true behind HTTPS)
SIM_SECURE_COOKIES=false
# MCP server URL for the console; or SIM_MCP_HOSTPORT=host:port on a private network
SIM_MCP_URL=http://127.0.0.1:8090/mcp
SIM_MCP_HOSTPORT=
# Same meaning as MCP_TRUST_PROXY, for the console's per-visitor limiters
SIM_TRUST_PROXY=false
# rules (offline, default) | claude-bedrock (Claude in Amazon Bedrock) | claude-api (Anthropic API)
BRAIN=rules
# Default: anthropic.claude-opus-5-5 on Bedrock, claude-opus-5-5 on the Anthropic API
CLAUDE_MODEL=
# low (default, fastest for voice) | medium | high
CLAUDE_EFFORT=low
# Claude in Amazon Bedrock: separate from any other AWS_* credentials in the environment.
# The IAM principal needs bedrock-mantle:CreateInference on the Claude model ARNs.
BEDROCK_REGION=us-east-1
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# Or a short-term Bedrock bearer token instead of the key pair
BEDROCK_API_KEY=
ANTHROPIC_API_KEY=
# Text-to-speech (Polly) region
AWS_REGION=us-east-1
